{
  "version": 1,
  "description": "Production budgets calibrated against the current spreadsheet feature set and stable vendor chunks.",
  "distDirectory": "apps/web/dist",
  "entryAssets": {
    "javascript": {
      "pattern": "^index-.*\\.js$",
      "maximumRawBytes": 290000,
      "maximumGzipBytes": 78000
    },
    "css": {
      "pattern": "^index-.*\\.css$",
      "maximumRawBytes": 75000,
      "maximumGzipBytes": 12000
    }
  },
  "totalAssets": {
    "javascript": {
      "maximumRawBytes": 760000,
      "maximumGzipBytes": 228000
    },
    "css": {
      "maximumRawBytes": 210000,
      "maximumGzipBytes": 27000
    }
  }
}
