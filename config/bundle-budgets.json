{
  "version": 1,
  "description": "Measured production budgets include the workbook UI and twelve number-format categories backed by numfmt in Core and the XLSX Worker. Worker assets remain included in totals and their separate cap; see ADR 0004.",
  "distDirectory": "apps/web/dist",
  "entryAssets": {
    "javascript": {
      "pattern": "^index-.*\\.js$",
      "maximumRawBytes": 650000,
      "maximumGzipBytes": 190000
    },
    "css": {
      "pattern": "^index-.*\\.css$",
      "maximumRawBytes": 128000,
      "maximumGzipBytes": 19000
    }
  },
  "totalAssets": {
    "javascript": {
      "maximumRawBytes": 2330000,
      "maximumGzipBytes": 675000
    },
    "css": {
      "maximumRawBytes": 300000,
      "maximumGzipBytes": 40000
    }
  },
  "deferredWorkers": {
    "pattern": "^(?:workbookXlsx\\.worker|worker-).*\\.js$",
    "maximumRawBytes": 1100000,
    "maximumGzipBytes": 316000
  }
}
