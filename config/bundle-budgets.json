    "css": {
      "pattern": "^index-.*\\.css$",
      "maximumRawBytes": 78000,
      "maximumGzipBytes": 12000
    }
  },
  "totalAssets": {
    "javascript": {
      "maximumRawBytes": 850000,
      "maximumGzipBytes": 252000
    },
    "css": {
      "maximumRawBytes": 220000,
      "maximumGzipBytes": 28000
    }
  }
}
