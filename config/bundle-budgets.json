{
  "version": 1,
  "description": "Production budgets include workbook persistence, image clipboard/conversion and lazy fullscreen preview support, plus the formula foundation; see ADR 0004.",
  "distDirectory": "apps/web/dist",
  "entryAssets": {
    "javascript": {
      "pattern": "^index-.*\\.js$",
      "maximumRawBytes": 360000,
      "maximumGzipBytes": 100000
    },
    "css": {
      "pattern": "^index-.*\\.css$",
      "maximumRawBytes": 78000,
      "maximumGzipBytes": 12000
    }
  },
  "totalAssets": {
    "javascript": {
      "maximumRawBytes": 910000,
      "maximumGzipBytes": 265000
    },
    "css": {
      "maximumRawBytes": 240000,
      "maximumGzipBytes": 31000
    }
  }
}
