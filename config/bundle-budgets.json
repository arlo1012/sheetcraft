{
  "version": 1,
  "description": "Production budgets combine shared formula editing, the lazy XLSX codec Worker and image tools with sheet management and the configurable two-row footer. Worker assets remain included in totals and their separate cap; see ADR 0004.",
  "distDirectory": "apps/web/dist",
  "entryAssets": {
    "javascript": {
      "pattern": "^index-.*\\.js$",
      "maximumRawBytes": 465000,
      "maximumGzipBytes": 130000
    },
    "css": {
      "pattern": "^index-.*\\.css$",
      "maximumRawBytes": 90000,
      "maximumGzipBytes": 13400
    }
  },
  "totalAssets": {
    "javascript": {
      "maximumRawBytes": 2035000,
      "maximumGzipBytes": 580000
    },
    "css": {
      "maximumRawBytes": 250000,
      "maximumGzipBytes": 34000
    }
  },
  "deferredWorkers": {
    "pattern": "^(?:workbookXlsx\\.worker|worker-).*\\.js$",
    "maximumRawBytes": 1020000,
    "maximumGzipBytes": 288000
  }
}
