{
  "version": 1,
  "description": "Post-split production budgets calibrated against the stable app, Vue, TDesign, and icon chunks.",
  "distDirectory": "apps/web/dist",
  "entryAssets": {
    "javascript": {
      "pattern": "^index-.*\\.js$",
      "maximumRawBytes": 190000,
      "maximumGzipBytes": 55000
    },
    "css": {
      "pattern": "^index-.*\\.css$",
      "maximumRawBytes": 75000,
      "maximumGzipBytes": 12000
    }
  },
  "totalAssets": {
    "javascript": {
      "maximumRawBytes": 675000,
      "maximumGzipBytes": 205000
    },
    "css": {
      "maximumRawBytes": 210000,
      "maximumGzipBytes": 27000
    }
  }
}
