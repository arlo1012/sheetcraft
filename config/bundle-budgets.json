{
  "version": 1,
  "description": "Production budgets include workbook persistence, cell/floating images and portable asset bundles, plus the formula foundation; see ADR 0004.",
  "distDirectory": "apps/web/dist",
  "entryAssets": {
    "javascript": {
      "pattern": "^index-.*\\.js$",
      "maximumRawBytes": 350000,
      "maximumGzipBytes": 97000
