{
  "version": 1,
  "description": "Production budgets include shared editing sessions, eight runtime functions, the lazy XLSX codec Worker with native cell-image export, plus existing image tools. Deferred Workers remain included in total assets and have a separate cap; see ADR 0004.",
  "distDirectory": "apps/web/dist",
  "entryAssets": {
    "javascript": {
      "pattern": "^index-.*\\.js$",
      "maximumRawBytes": 435000,
      "maximumGzipBytes": 122000
    },
    "css": {
      "pattern": "^index-.*\\.css$",
      "maximumRawBytes": 82000,
      "maximumGzipBytes": 12500
    }
  },
  "totalAssets": {
    "javascript": {
      "maximumRawBytes": 2000000,
      "maximumGzipBytes": 570000
    },
    "css": {
      "maximumRawBytes": 242000,
      "maximumGzipBytes": 32500
    }
  },
  "deferredWorkers": {
    "pattern": "^(?:workbookXlsx\\.worker|worker-).*\\.js$",
    "maximumRawBytes": 1020000,
    "maximumGzipBytes": 288000
  }
}
