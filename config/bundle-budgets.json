{
  "version": 1,
  "description": "Measured production budgets include the formula workbench with 96 functions, workbook references and defined names in Core and the XLSX Worker. Totals include deferred assets; see ADR 0004 for isolated baseline and feature increments.",
  "distDirectory": "apps/web/dist",
  "entryAssets": {
    "javascript": {
      "pattern": "^index-.*\\.js$",
      "maximumRawBytes": 650000,
      "maximumGzipBytes": 190000
    },
    "css": {
      "pattern": "^index-.*\\.css$",
      "maximumRawBytes": 152000,
      "maximumGzipBytes": 22000
    }
  },
  "totalAssets": {
    "javascript": {
      "maximumRawBytes": 2600000,
      "maximumGzipBytes": 750000
    },
    "css": {
      "maximumRawBytes": 322000,
      "maximumGzipBytes": 43000
    }
  },
  "deferredWorkers": {
    "pattern": "^(?:workbookXlsx\\.worker|worker-).*\\.js$",
    "maximumRawBytes": 1170000,
    "maximumGzipBytes": 335000
  }
}
