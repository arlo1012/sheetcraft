{
  "name": "@idea10/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 7200",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 7200",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings src vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.1",
    "@idea10/core": "workspace:*",
    "@idea10/sheet-engine": "workspace:*",
    "@idea10/xlsx-io": "workspace:*",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "fflate": "0.8.3",
    "katex": "^0.19.0",
    "lucide-vue-next": "^1.0.0",
    "nspell": "^2.1.5",
    "opencc-js": "^1.4.2",
    "pinyin-pro": "^3.29.4",
    "tdesign-vue-next": "^1.20.7",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.10"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/nspell": "^2.1.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
