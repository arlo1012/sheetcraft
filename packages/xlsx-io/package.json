{
  "name": "@sheetcraft/xlsx-io",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./picture-capabilities": {
      "types": "./dist/picture-capabilities.d.ts",
      "import": "./dist/picture-capabilities.js"
    },
    "./chart-capabilities": {
      "types": "./dist/chart-capabilities.d.ts",
      "import": "./dist/chart-capabilities.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@noble/ciphers": "2.1.1",
    "@noble/hashes": "2.0.1",
    "@scure/base": "2.0.0",
    "@sheetcraft/core": "workspace:*",
    "cfb": "1.2.2",
    "fast-xml-parser": "5.3.8",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@types/node": "26.3.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
