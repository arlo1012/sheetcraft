{
  "name": "idea10",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter @idea10/web dev",
    "build": "bun run --filter @idea10/web build",
    "preview": "bun run --filter @idea10/web preview",
    "typecheck": "bun run --filter @idea10/web typecheck",
    "test": "bun run --filter @idea10/web test",
    "test:watch": "bun run --filter @idea10/web test:watch",
    "lint": "bun run --filter @idea10/web lint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.3.11"
}
