{
  "name": "idea10",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run build:packages && bun run --filter @idea10/web dev",
    "build": "bun run build:packages && bun run build:web",
    "build:packages": "bun run build:core && bun run build:sheet-engine",
    "build:core": "bun run --filter @idea10/core build",
    "build:sheet-engine": "bun run --filter @idea10/sheet-engine build",
    "build:web": "bun run --filter @idea10/web build",
    "preview": "bun run --filter @idea10/web preview",
    "typecheck": "bun run typecheck:core && bun run build:core && bun run typecheck:sheet-engine && bun run build:sheet-engine && bun run typecheck:web",
    "typecheck:core": "bun run --filter @idea10/core typecheck",
    "typecheck:sheet-engine": "bun run --filter @idea10/sheet-engine typecheck",
    "typecheck:web": "bun run --filter @idea10/web typecheck",
    "test": "bun run build:packages && bun run test:core && bun run test:sheet-engine && bun run test:web",
    "test:core": "bun run --filter @idea10/core test",
    "test:sheet-engine": "bun run --filter @idea10/sheet-engine test",
    "test:web": "bun run --filter @idea10/web test",
    "test:watch": "bun run --filter @idea10/web test:watch",
    "lint": "bun run lint:core && bun run lint:sheet-engine && bun run lint:web && bun run lint:tools",
    "lint:core": "oxlint --deny-warnings packages/core/src packages/core/vitest.config.ts",
    "lint:sheet-engine": "oxlint --deny-warnings packages/sheet-engine/src packages/sheet-engine/vitest.config.ts",
    "lint:web": "bun run --filter @idea10/web lint",
    "lint:tools": "oxlint --deny-warnings scripts",
    "check:boundaries": "bun scripts/check-boundaries.mts",
    "verify:packages": "bun run build:packages && bun scripts/verify-package-imports.mts",
    "verify:worker": "bun run build:packages && bun scripts/verify-worker-bundle.mts",
    "check:bundle": "bun run build && bun scripts/check-web-bundle.mts",
    "ci": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run check:boundaries && bun run verify:packages && bun run verify:worker && bun run check:bundle",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@idea10/core": "workspace:*",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.6",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "sass": "^1.103.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "bun@1.3.11"
}
